---
import Layout from "../../layouts/Layout.astro";
import type { ApiData, Service } from "../../interfaces/dbData";
import EliminarCaracteresEspeciales from "@/hook/EliminarCaracteresEspeciales";
import TransparentHeader from "@/components/TransparentHeader/TransparentHeader";
import ButtonContent_2 from "@/components/button/ButtonContent_2";
import SliderServicesDetail from "@/components/Sliders/SliderServicesDetail";
import LazyImage from "@/components/LazyImage";
import ContactForm from "@/components/Blocks/contact/ContactForm";
import UseTextHidden from "@/hook/UseTextHidden";
const { slug } = Astro.params;

let UrlApi = import.meta.env.API_URL;
let KetApi = import.meta.env.API_KEY;
// Realiza la llamada a la API
const response = await fetch(`${UrlApi}/${KetApi}`);
const data: ApiData = await response.json();

const dataServices = data?.services;

//filtrar para obtener el servicio seleccionado
const serviceInfo = data?.services.find((service: Service) => {
  const serviceSlug = EliminarCaracteresEspeciales(service.title);
  const targetSlug = EliminarCaracteresEspeciales(slug || "");

  return serviceSlug === targetSlug;
});

const logoCompany = data?.logos.primary;
---

<Layout
  title={`${data?.name} | ${serviceInfo?.title}`}
  description={`${serviceInfo?.description[0].text}]}`}
  keywords={`${serviceInfo?.title}, ${data?.name}`}
  favicon={data.logos.primary}
  featuredImage={serviceInfo?.description[0].image!}
>

  <TransparentHeader
    bgImages={`${serviceInfo?.description[0].image}`}
    title={`${serviceInfo?.title}`}
    client:load
  />


  <!-- NUEVO DISEÑO APAISADO: todos los elementos en una sola fila en desktop -->

  <section class="w-full bg-white py-16">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-stretch gap-8 px-4">
      <!-- Imagen -->
      <div class="flex-1 flex justify-center items-center md:w-1/2">
        <LazyImage
          src={`${serviceInfo?.description[0].image}`}
          alt={`${serviceInfo?.title}`}
          height={350}
          className="w-full object-cover rounded-3xl shadow-xl"
          client:load
        />
      </div>
      <!-- Contenido principal -->
      <div class="flex-1 flex flex-col gap-6 justify-center min-w-[280px] max-w-xl">
        <span class="text-sm font-semibold text-yellow-500 tracking-widest uppercase">
          <UseTextHidden text="Our Services" client:load />
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-2 leading-tight">{serviceInfo?.title}</h1>
        <p class="text-lg text-gray-600 mb-4">{serviceInfo?.description[0].text}</p>
        {serviceInfo?.description && serviceInfo?.description.length > 1 && (
          <p class="text-base text-gray-500 mb-2">{serviceInfo?.description[1].text}</p>
        )}
      </div>
    </div>
    <!-- Lista de servicios y contacto debajo del contenido principal -->
    <div class="w-full relative bg-primary py-12 mt-10">
      <div class="absolute inset-0 w-full h-full bg-[#1a1919c0]"/>
      <div class="w-[90%] mx-auto px-4 z-40 relative">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8 mb-10">
          <div class="md:w-1/2 md:pr-28">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">
              <UseTextHidden text="Feel Free To " client:load />
              <span class="text-primary"><UseTextHidden text="Contact Us" client:load /></span>
            </h2>
            <p class="text-base text-gray-300 mb-6">
              <UseTextHidden text="If you have questions or need help, contact us and we will get back to you as soon as possible." client:load />
            </p>
            <div class="flex gap-4">
              {data.redesSociales?.map((social) => {
                let icon = '';
                let label = '';
                if (social.name.toLowerCase().includes('facebook')) {
                  icon = 'fa-facebook';
                  label = 'Facebook';
                } else if (social.name.toLowerCase().includes('twitter') || social.name.toLowerCase().includes('x.com')) {
                  icon = 'fa-twitter';
                  label = 'Twitter';
                } else if (social.name.toLowerCase().includes('youtube')) {
                  icon = 'fa-youtube';
                  label = 'YouTube';
                } else if (social.name.toLowerCase().includes('instagram')) {
                  icon = 'fa-instagram';
                  label = 'Instagram';
                } else if (social.name.toLowerCase().includes('linkedin')) {
                  icon = 'fa-linkedin';
                  label = 'LinkedIn';
                } else if (social.name.toLowerCase().includes('tiktok')) {
                  icon = 'fa-tiktok';
                  label = 'TikTok';
                } else if (social.name.toLowerCase().includes('vimeo')) {
                  icon = 'fa-vimeo';
                  label = 'Vimeo';
                } else {
                  icon = 'fa-globe';
                  label = social.name;
                }
                return (
                  <a href={social.link} class="text-white hover:text-primary" target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
                    <i class={`fab ${icon} fa-lg`}></i>
                  </a>
                );
              })}
            </div>
          </div>
          <div class="md:w-1/2 flex flex-col md:flex-row gap-6 justify-end">
            <!-- Card: Dirección -->
            <div class="flex-1 bg-[#210909] border border-[#868585] rounded-2xl shadow-lg p-8 flex flex-col items-center text-center min-w-[220px] max-w-xs mx-auto">
              <div class="bg-primary rounded-full w-16 h-16 flex items-center justify-center mb-4 shadow-lg">
                <i class="fa-solid fa-location-dot text-white text-3xl"></i>
              </div>
              <h3 class="text-xl font-semibold text-white mb-2">
                <UseTextHidden text="Location" client:load />
              </h3>
              <p class="text-base text-gray-200">{data.dataGeneral.location[0].city || 'Address not available'}</p>
            </div>
            <!-- Card: Phone -->
            <div class="flex-1 bg-[#210909] border border-[#a97c7c] rounded-2xl shadow-lg p-8 flex flex-col items-center text-center min-w-[220px] max-w-xs mx-auto">
              <div class="bg-primary rounded-full w-16 h-16 flex items-center justify-center mb-4 shadow-lg">
                <i class="fa-solid fa-phone-volume text-white text-3xl"></i>
              </div>
              <h3 class="text-xl font-semibold text-white mb-2">
                <UseTextHidden text="Phone Number" client:load />
              </h3>
              <p class="text-base text-gray-200">{data.dataGeneral.phones[0].number}</p>
            </div>
            <!-- Card: Email -->
            <div class="flex-1 bg-[#210909] border border-[#a97c7c] rounded-2xl shadow-lg p-8 flex flex-col items-center text-center min-w-[220px] max-w-xs mx-auto">
              <div class="bg-primary rounded-full w-16 h-16 flex items-center justify-center mb-4 shadow-lg">
                <i class="fa-solid fa-envelope text-white text-3xl"></i>
              </div>
              <h3 class="text-xl font-semibold text-white mb-2">
                <UseTextHidden text="Email Address" client:load />
              </h3>
              <p class="text-base text-gray-200">{data.dataGeneral.emails[0].email}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="w-full mb-44">
    <SliderServicesDetail
      dataServices={dataServices}
      logoCompany={logoCompany}
      client:load
    />
  </div>
</Layout>
