---
import Layout from "../../layouts/Layout.astro";

import type { ApiData, Service } from "../../interfaces/dbData";
import Map from "@/components/areas/Map";
import FormatText from "@/hook/FormatText";

const { id, location } = Astro.params;
let UrlApi = import.meta.env.API_URL;
let KetApi = import.meta.env.API_KEY;
// Realiza la llamada a la API
const response = await fetch(`${UrlApi}/${KetApi}`);
const data: ApiData = await response.json();

// Si areasWeServe está desactivado, devolver 404
if (!data.widgets?.areasweserve) {
  return new Response(null, { status: 404 });
}

// Encontrar el servicio por ID (slug del servicio)
const service = data.services.find(
  (service: Service) => FormatText(service.title) === id
);

// Resolver ciudad a partir del slug de location (usar lista completa para no perder coincidencias)
const locObj = data.dataGeneral.location?.find((l: any) => FormatText(l.city) === location);
const cityName = locObj?.city ?? (location || "");

// Limitar a las primeras 5 locations para el resto del render en esta página
const top3Locations = (data.dataGeneral.location ?? []).slice(1, 5);
data.dataGeneral.location = top3Locations as any;

// Imagen de fondo del hero (usar si existe, si no, color de fondo)
const bgImage = service?.description?.[0]?.image || data.gallery?.[0] || "";
// Meta description: primera oración (hasta el primer punto)
const rawDesc = service?.description?.[0]?.text ?? "";
const dotIdx = rawDesc.indexOf(".");
const firstSentence = (dotIdx !== -1 ? rawDesc.slice(0, dotIdx + 1) : rawDesc).trim();
const metaDescription = firstSentence || `${service?.title ?? "Service"}${cityName ? ` in ${cityName}` : ""}.`;
---

<Layout
  title={`${service?.title} in ${cityName} | ${data.name}`}
  description={metaDescription}
  favicon={data.logos.primary}
  featuredImage={service?.description[0].image!}
  keywords={`${service?.title} in ${cityName}, ${data.services.map((s: any) => s.title).join(", ")}`}
>
  <!-- JSON-LD para SEO: Service con areaServed -->
  {service ? (
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: `${service.title} ${cityName ? `in ${cityName}` : ''}`.trim(),
        provider: {
          '@type': 'LocalBusiness',
          name: data.name,
          image: data.logos.primary,
        },
        areaServed: cityName || undefined,
        description: service.description?.[0]?.text,
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Services',
          itemListElement: data.services.map((s) => ({
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: s.title,
            },
          })),
        },
      })}
    </script>
  ) : null}

  <!-- 
    ==========================================
    HERO CON EFECTO VIDRIO Y FONTAWESOME
    ==========================================
  -->
  <section class="relative w-full md:h-[90vh] h-[80vh] overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 flex items-center">
    <!-- Imagen de fondo con opacidad controlada -->
    <img 
      class="absolute inset-0 w-full h-full object-cover object-center opacity-40 mix-blend-overlay" 
      src={bgImage} 
      alt={`${service?.title} background`} 
    />
    <!-- Patrón de cuadrícula decorativo (le da textura) -->
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmZmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSI+PHBhdGggZD0iTTM2IDM0djJIMjR2LTJoMTJ6TTM2IDI0djJIMjR2LTJoMTJ6Ii8+PC9nPjwvZz48L3N2Zz4=')] opacity-50"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
        <!-- Texto principal del Hero -->
        <div class="lg:col-span-3 text-white space-y-6">
          <!-- Migas de pan con iconos FontAwesome -->
          <nav class="flex items-center space-x-2 text-white/70 text-sm font-medium tracking-wider">
            <a href="/" class="hover:text-secondary transition-colors flex items-center gap-2">
              <i class="fa-solid fa-house text-secondary"></i> Home
            </a>
            <i class="fa-solid fa-chevron-right text-xs"></i>
            <a href="/services" class="hover:text-secondary transition-colors">Services</a>
            <i class="fa-solid fa-chevron-right text-xs"></i>
            <span class="text-secondary font-semibold">{service?.title}</span>
          </nav>

          <h1 class="text-white font-extrabold leading-tight text-5xl md:text-7xl">
            {service?.title}
            {cityName ? (
              <span class="block text-2xl md:text-3xl font-medium text-white/80 mt-3">
                <i class="fa-solid fa-location-dot text-secondary mr-2"></i>
                in <span class="text-secondary font-semibold">{cityName}</span>
              </span>
            ) : null}
          </h1>

          <p class="text-xl text-white/80 max-w-2xl leading-relaxed border-l-4 border-secondary pl-6">
            <i class="fa-solid fa-quote-left text-secondary/50 mr-2"></i>
            {firstSentence || service?.description?.[0]?.text}
          </p>

          <div class="flex flex-wrap gap-4 pt-4">
            <a href="/contact" class="group inline-flex items-center gap-3 bg-secondary text-white px-8 py-4 rounded-lg font-bold shadow-xl shadow-secondary/30 hover:bg-secondary/90 transition-all transform hover:-translate-y-1">
              <i class="fa-solid fa-file-signature"></i>
              Get a Free Quote 
              <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
            {data.dataGeneral.phones?.[0]?.number ? (
              <a href={`tel:+1${data.dataGeneral.phones[0].number}`} class="group inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm text-white px-8 py-4 rounded-lg font-semibold border border-white/20 hover:bg-white/20 transition-all">
                <i class="fa-solid fa-phone-volume"></i> 
                <span class="tracking-wider">{data.dataGeneral.phones[0].number}</span>
              </a>
            ) : null}
          </div>
        </div>

        <!-- Tarjeta de contacto con efecto VIDRIO en el Hero -->
        <div class="lg:col-span-2">
          <div class="bg-white/10 backdrop-blur-xl rounded-2xl border border-white/20 shadow-2xl p-8 text-white">
            <div class="text-center space-y-5">
              <div class="inline-flex p-4 bg-secondary/20 rounded-full">
                <i class="fa-solid fa-stars text-2xl text-secondary"></i>
              </div>
              <h3 class="text-2xl font-bold">Request Your Free Quote</h3>
              <p class="text-white/70 flex items-center justify-center gap-2">
                <i class="fa-solid fa-clock text-secondary"></i>
                We'll get back to you within 24 hours.
              </p>
              <div class="space-y-3">
                {data.dataGeneral.phones?.slice(0,2).map((phone: any) => (
                  <a href={`tel:+1${phone.number}`} class="flex items-center justify-center gap-3 w-full bg-secondary hover:bg-white hover:text-gray-900 text-white py-3.5 rounded-lg font-semibold transition-all transform hover:scale-105">
                    <i class="fa-solid fa-phone"></i> {phone.number}
                  </a>
                ))}
                <a href="/contact" class="flex items-center justify-center gap-3 w-full border border-white/30 hover:bg-white/20 py-3.5 rounded-lg font-semibold transition-all backdrop-blur-sm">
                  <i class="fa-solid fa-envelope"></i> Contact Form
                </a>
              </div>
              {cityName ? (
                <div class="pt-4 mt-4 border-t border-white/20">
                  <p class="text-xs flex items-center justify-center gap-2 text-white/60">
                    <i class="fa-solid fa-map-pin text-secondary"></i> 
                    Available in {cityName} & nearby areas
                  </p>
                </div>
              ) : null}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 
    ==============================
    CONTENIDO EN PANELES CON MATICES
    ==============================
  -->
  <section class="relative max-w-7xl mx-auto px-6 md:px-8 py-16 lg:py-24">
    <!-- Fondo decorativo -->
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-slate-50 to-white -z-10"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Columna Principal (2/3) -->
      <div class="lg:col-span-2 space-y-16">
        {service?.description.map((desc: any, idx: number) => (
          <article class={`group grid grid-cols-1 md:grid-cols-2 gap-8 items-center ${idx % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
            <!-- Panel de Imagen -->
            <div class="relative overflow-hidden rounded-2xl shadow-lg group-hover:shadow-xl transition-all duration-500">
              <img 
                src={desc.image} 
                alt={service?.title} 
                class="w-full h-[280px] md:h-[380px] object-cover transform group-hover:scale-105 transition-transform duration-700" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm text-gray-800 px-4 py-2 rounded-full text-sm font-medium flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-2 group-hover:translate-y-0">
                <i class="fa-solid fa-image"></i> {service?.title}
              </div>
            </div>
            
            <!-- Panel de Texto con Matiz -->
            <div class="space-y-5 p-6 md:p-0">
              <div class="inline-flex items-center gap-2 text-secondary bg-secondary/10 px-4 py-2 rounded-full text-sm font-semibold tracking-wider">
                <i class="fa-solid fa-circle-check"></i>
                EXPERT SERVICE
              </div>
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight">
                {service?.title}
                {cityName ? (
                  <span class="block text-primary/80 text-xl font-medium mt-1">
                    <i class="fa-solid fa-city text-secondary mr-1"></i>
                    in {cityName}
                  </span>
                ) : ''}
              </h2>
              <p class="text-gray-600 leading-relaxed text-lg">{desc.text}</p>
              <div class="flex gap-3 pt-2">
                <a href="/contact" class="inline-flex items-center gap-2 bg-secondary text-white px-5 py-2.5 rounded-lg font-semibold group/link hover:bg-primary transition-all shadow-md shadow-secondary/20">
                  <i class="fa-solid fa-calendar-check"></i>
                  Schedule Service
                  <i class="fa-solid fa-arrow-right group-hover/link:translate-x-1 transition-transform"></i>
                </a>
                <a href={`tel:+1${data.dataGeneral.phones?.[0]?.number || ''}`} class="inline-flex items-center gap-2 border border-gray-300 text-gray-700 px-5 py-2.5 rounded-lg font-semibold hover:border-secondary hover:text-secondary transition-all">
                  <i class="fa-solid fa-phone"></i>
                  Call Now
                </a>
              </div>
            </div>
          </article>
        ))}

        <!-- Panel de Ubicación Actual con Matiz Azul -->
        {cityName ? (
          <div class="bg-gradient-to-br from-blue-50 via-indigo-50 to-purple-50 rounded-2xl p-8 border border-blue-100 shadow-md">
            <div class="flex items-start gap-5">
              <div class="p-4 bg-blue-100 rounded-xl">
                <i class="fa-solid fa-map-location-dot text-2xl text-blue-600"></i>
              </div>
              <div>
                <h3 class="text-xl font-bold text-gray-900 mb-2 flex items-center gap-2">
                  <i class="fa-solid fa-building-flag text-secondary"></i>
                  Proudly Serving {cityName}
                </h3>
                <p class="text-gray-700 leading-relaxed">
                  We proudly offer <strong class="text-secondary">{service?.title}</strong> in <strong>{cityName}</strong> and the surrounding communities. Our local team is ready to provide you with exceptional service tailored to your needs.
                </p>
                <div class="flex items-center gap-3 mt-4 text-sm text-gray-600">
                  <span class="flex items-center gap-1">
                    <i class="fa-solid fa-trophy text-amber-500"></i> Top Rated
                  </span>
                  <span class="flex items-center gap-1">
                    <i class="fa-solid fa-shield-halved text-green-500"></i> Licensed & Insured
                  </span>
                  <span class="flex items-center gap-1">
                    <i class="fa-solid fa-truck-fast text-blue-500"></i> Fast Response
                  </span>
                </div>
              </div>
            </div>
          </div>
        ) : null}
      </div>

      <!-- Barra Lateral (1/3) - Paneles Sticky con Matices -->
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-8">
          <!-- Panel de Contacto Primario -->
          <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
            <div class="bg-gradient-to-r from-secondary to-primary p-6 text-white text-center">
              <div class="flex justify-center mb-3">
                <div class="bg-white/20 p-3 rounded-full backdrop-blur-sm">
                  <img src={data.logos.primary} alt={data.name} class="w-12 h-12 object-contain" />
                </div>
              </div>
              <h3 class="text-xl font-bold flex items-center justify-center gap-2">
                <i class="fa-solid fa-clipboard-list"></i>
                Get a Free Estimate
              </h3>
              <p class="text-white/80 text-sm mt-1 flex items-center justify-center gap-2">
                <i class="fa-solid fa-clock"></i>
                Quick & Easy Process
              </p>
            </div>
            <div class="p-6 space-y-4">
              {data.dataGeneral.phones?.slice(0,2).map((phone: any, idx: number) => (
                <a 
                  href={`tel:+1${phone.number}`} 
                  class="flex items-center justify-center gap-3 w-full bg-gray-50 hover:bg-gray-100 text-gray-800 py-3.5 rounded-xl font-semibold transition-all border border-gray-200 group"
                >
                  <i class={`fa-solid ${idx === 0 ? 'fa-mobile-screen-button' : 'fa-headset'} text-secondary group-hover:scale-110 transition-transform`}></i> 
                  {phone.number}
                </a>
              ))}
              <a href="/contact" class="flex items-center justify-center gap-3 w-full bg-secondary hover:bg-primary text-white py-3.5 rounded-xl font-semibold transition-all shadow-md shadow-secondary/20">
                <i class="fa-solid fa-paper-plane"></i> Send a Message
              </a>
              <div class="flex items-center justify-center gap-4 pt-2 text-sm text-gray-500">
                <span class="flex items-center gap-1">
                  <i class="fa-solid fa-lock text-green-500"></i> Secure
                </span>
                <span class="flex items-center gap-1">
                  <i class="fa-solid fa-bolt text-amber-500"></i> Fast
                </span>
                <span class="flex items-center gap-1">
                  <i class="fa-solid fa-thumbs-up text-blue-500"></i> Reliable
                </span>
              </div>
            </div>
          </div>

          <!-- Panel de Servicios en esta Ciudad (Píldoras) -->
          {cityName ? (
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6">
              <h4 class="font-bold text-gray-900 mb-4 flex items-center gap-2 text-lg">
                <div class="p-2 bg-secondary/10 rounded-lg">
                  <i class="fa-solid fa-screwdriver-wrench text-secondary"></i>
                </div>
                Explore Services in {cityName}
              </h4>
              <div class="flex flex-wrap gap-2">
                {data.services
                  .filter((s: any) => FormatText(s.title) !== id)
                  .slice(0, 8)
                  .map((s: any) => (
                    <a
                      href={`/services/${FormatText(s.title)}-in-${FormatText(cityName)}`}
                      class="group inline-flex items-center gap-2 bg-gray-50 hover:bg-secondary/10 text-gray-700 hover:text-secondary px-4 py-2 rounded-full text-sm font-medium transition-all border border-gray-200 hover:border-secondary/30"
                    >
                      <i class="fa-solid fa-circle-dot text-xs text-secondary"></i>
                      {s.title}
                      <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                    </a>
                  ))}
              </div>
            </div>
          ) : null}

          <!-- Panel de Confianza -->
          <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl p-6 border border-amber-100">
            <div class="flex items-center gap-3 mb-3">
              <i class="fa-solid fa-star text-2xl text-amber-500"></i>
              <i class="fa-solid fa-star text-2xl text-amber-500"></i>
              <i class="fa-solid fa-star text-2xl text-amber-500"></i>
              <i class="fa-solid fa-star text-2xl text-amber-500"></i>
              <i class="fa-solid fa-star-half-stroke text-2xl text-amber-500"></i>
            </div>
            <p class="font-semibold text-gray-800 mb-2">Trusted by Your Neighbors</p>
            <p class="text-sm text-gray-600">Join hundreds of satisfied customers in {cityName || 'your area'} who trust us for quality service.</p>
            <div class="mt-3 flex items-center gap-2 text-xs text-gray-500">
              <i class="fa-solid fa-check-circle text-green-500"></i>
              Verified Reviews
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 
    ==================================
    PANELES DE OTROS SERVICIOS 
    ==================================
  -->
  {cityName ? (
    <section class="relative max-w-7xl mx-auto px-6 md:px-8 py-16 lg:py-24">
      <div class="absolute inset-0 bg-gradient-to-b from-slate-50 to-white -z-10 rounded-t-[3rem]"></div>
      <div class="text-center mb-16">
        <span class="text-secondary font-semibold tracking-widest text-sm flex items-center justify-center gap-2">
          <i class="fa-solid fa-grid-2"></i> EXPAND YOUR OPTIONS
        </span>
        <h3 class="text-4xl md:text-5xl font-bold text-gray-900 mt-3">
          Other <span class="text-secondary">Services</span> in <span class="text-secondary">{cityName}</span>
        </h3>
        <p class="text-gray-500 mt-3 max-w-2xl mx-auto flex items-center justify-center gap-2">
          <i class="fa-solid fa-magnifying-glass text-secondary"></i>
          Discover our complete range of professional services available in your area
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {data.services
          .filter((s: any) => FormatText(s.title) !== id)
          .slice(0, 6)
          .map((s: any) => (
            <a
              href={`/services/${FormatText(s.title)}-in-${FormatText(cityName)}`}
              class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm hover:shadow-xl hover:border-secondary/20 transition-all duration-300 transform hover:-translate-y-1"
            >
              <div class="flex justify-between items-start mb-5">
                <div class="p-3.5 bg-secondary/10 rounded-xl text-secondary group-hover:bg-secondary group-hover:text-white transition-all duration-300">
                  <i class="fa-solid fa-toolbox text-xl"></i>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square text-gray-400 group-hover:text-secondary transition-colors"></i>
              </div>
              <h4 class="text-xl font-bold text-gray-900 mb-2">{s.title}</h4>
              <p class="text-gray-500 text-sm line-clamp-2 mb-5">{s.description?.[0]?.text}</p>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-2 text-xs font-medium text-secondary bg-secondary/5 px-3 py-1.5 rounded-full">
                  <i class="fa-solid fa-location-dot"></i> 
                  Available in {cityName}
                </span>
                <span class="text-secondary opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0">
                  <i class="fa-solid fa-circle-arrow-right text-lg"></i>
                </span>
              </div>
            </a>
          ))}
      </div>
    </section>
  ) : null}

  <!-- 
    ==========================================
    PANELES DE SERVICIOS EN OTRAS UBICACIONES
    ==========================================
  -->
  {service && cityName ? (
    <section class="max-w-7xl mx-auto px-6 md:px-8 py-16 lg:py-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-secondary font-semibold tracking-widest text-sm flex items-center gap-2">
            <i class="fa-solid fa-earth-americas"></i> WE ARE EVERYWHERE
          </span>
          <h3 class="text-4xl md:text-5xl font-bold text-gray-900 mt-3">
            Other <span class="text-secondary">Locations</span>
          </h3>
        </div>
        <a href="/locations" class="text-secondary font-semibold flex items-center gap-2 group bg-secondary/5 px-5 py-2.5 rounded-full hover:bg-secondary/10 transition-all">
          <i class="fa-solid fa-list-ul"></i>
          View all locations 
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {data.services
          .filter((s: any) => FormatText(s.title) !== id)
          .flatMap((s: any) =>
            (data.dataGeneral.location ?? []).slice(1, 6)
              .filter((l: any) => FormatText(l.city) !== FormatText(cityName))
              .map((l: any) => ({ service: s, location: l }))
          )
          .slice(0, 6)
          .map(({ service: s, location: l }:any) => (
            <a
              href={`/services/${FormatText(s.title)}-in-${FormatText(l.city)}`}
              class="group bg-white rounded-2xl p-5 border border-gray-100 shadow-sm hover:shadow-lg transition-all flex items-center gap-4 hover:border-secondary/20"
            >
              <div class="p-3 bg-gradient-to-br from-amber-50 to-orange-50 text-amber-600 rounded-xl group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-map-pin text-lg"></i>
              </div>
              <div class="flex-1">
                <p class="font-bold text-gray-800 group-hover:text-secondary transition-colors">{s.title}</p>
                <p class="text-sm text-gray-500 flex items-center gap-1.5">
                  <i class="fa-solid fa-location-crosshairs text-xs"></i> 
                  in <span class="font-medium text-primary">{l.city}</span>
                </p>
              </div>
              <i class="fa-solid fa-chevron-right text-gray-400 group-hover:translate-x-1 group-hover:text-secondary transition-all"></i>
            </a>
          ))}
      </div>
    </section>
  ) : null}

  <!-- Mapa envuelto en un panel elegante -->
  <div class="max-w-7xl mx-auto px-6 md:px-8 pb-16 lg:pb-24">
    <div class="rounded-3xl overflow-hidden shadow-2xl border border-gray-100">
      <div class="bg-gradient-to-r from-secondary to-primary p-4 -mb-16 relative text-white flex items-center gap-3">
        <i class="fa-solid fa-map text-xl"></i>
        <span class="font-semibold">Find Us in {cityName || 'Your Area'}</span>
        <i class="fa-solid fa-location-dot ml-auto animate-bounce"></i>
      </div>
      <Map data={data} selectedUrlCity={locObj?.urlCity} showCityList={false} singleCityName={cityName} />
    </div>
  </div>
</Layout>